{
  "name": "olea-workbench",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "olea-workbench — DEV TOOLING (WB-1 / ol-with, D-021). Mounts the real plugin views against olea-core and an in-memory VaultSource over the synthetic fixture vault, with no Obsidian runtime. Not a product surface.",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --configLoader=runner",
    "build": "node build.mjs production",
    "build:single": "node build.mjs production && node bundle-single-file.mjs",
    "dev": "node build.mjs serve",
    "verify": "node build.mjs verify",
    "e2e:build": "WB_DIST=./dist-e2e node build.mjs production",
    "e2e:verify": "WB_DIST=./dist-e2e node build.mjs verify",
    "e2e": "pnpm run e2e:build && pnpm run e2e:verify && playwright test"
  },
  "dependencies": {
    "olea-contracts": "workspace:*",
    "olea-core": "workspace:*",
    "olea-synthetic": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.2"
  }
}
